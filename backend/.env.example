# Server Configuration
PORT=5001

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:8080

# PostgreSQL Database Configuration
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_HOST=localhost
DB_PORT=5432
DB_NAME=luna

# Auth (session-based)
SESSION_TTL_DAYS=30

# Bedtime reminders
BEDTIME_REMINDERS_ENABLED=true
REMINDER_POLL_MS=60000
REMINDER_FROM_EMAIL=Sleep Guardian <reminders@example.com>
RESEND_API_KEY=your_resend_api_key_here
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_PHONE=+15555550123

# Google Calendar OAuth
# Keep false to disable Google sync safely while preserving integration code.
GOOGLE_SYNC_ENABLED=false
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5001/api/google/oauth2callback
