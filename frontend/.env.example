# Base URL for the Express API. Vite bakes this in at build time.
# Local dev: `.env.development` uses 127.0.0.1 to avoid some localhost/IPv6 issues.
# Override here or in `.env.development` if needed.
VITE_API_BASE_URL=http://localhost:5001

# Production builds should set this to your deployed API origin, for example:
# VITE_API_BASE_URL=https://your-api.example.com
