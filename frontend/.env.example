# Base URL for the Express API. Vite bakes this in at build time.
#
# Local dev: leave unset to use same-origin /api (Vite proxies to port 5001). Avoids CORS when
# you open the app at http://127.0.0.1:8080 vs http://localhost:8080 or over LAN.
# Or set explicitly, e.g. VITE_API_BASE_URL=http://localhost:5001
#
# VITE_DEV_API_PROXY=http://127.0.0.1:5001

# Production builds should set this to your deployed API origin, for example:
# VITE_API_BASE_URL=https://your-api.example.com
